# ============================================================
# 端到端验证专用环境（仅本地自动化测试用，验证完可删）
#
# 用法：npm run build:h5 -- --mode e2e
# 指向本机 8011 端口的测试后端（sqlite，SMS_PROVIDER=none）
# ============================================================
VITE_API_BASE_URL=http://127.0.0.1:8011/api
VITE_SSE_BASE_URL=http://127.0.0.1:8011/api
VITE_APP_TITLE=恋爱大师（E2E）

# ---------- ICP 备案信息（「我的」页底部展示并链接工信部） ----------
# 境内运营需在显著位置标注备案号并链接 https://beian.miit.gov.cn
# 未配置时界面显示「备案号待配置」占位，不会留空
VITE_BEIAN_ICP=
VITE_BEIAN_OWNER=
# 公安备案号（可选），形如 闽公网安备35010002000000号
VITE_BEIAN_POLICE=
