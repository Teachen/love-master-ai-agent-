# ============================================================
# 开发环境配置（npm run dev:h5 / dev:mp-weixin / dev:app）
#
# 仅 VITE_ 前缀的变量会被注入前端代码，通过 import.meta.env.VITE_XXX 读取。
# 修改后需重启 dev server 才生效。
# ============================================================

# 后端地址（本项目 Python 服务：python main.py，端口 8000）
# 对接 Java 参考版则改为 http://localhost:8123/api
VITE_API_BASE_URL=http://localhost:8000/api

# SSE 流式接口地址
# H5/App 用原生 EventSource、小程序用 wx.request，两者都不走 vite 代理，
# 因此这里必须是完整地址（不能写相对路径 /api）。
VITE_SSE_BASE_URL=http://localhost:8000/api

# 应用标题（H5 页面 title）
VITE_APP_TITLE=恋爱大师

# ---------- ICP 备案信息（「我的」页底部展示并链接工信部） ----------
# 境内运营需在显著位置标注备案号并链接 https://beian.miit.gov.cn
# 未配置时界面显示「备案号待配置」占位，不会留空
VITE_BEIAN_ICP=闽ICP备2022001906号
VITE_BEIAN_OWNER=
# 公安备案号（可选），形如 闽公网安备35010002000000号
VITE_BEIAN_POLICE=
