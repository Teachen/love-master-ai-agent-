# ============================================================
# 预发 / 测试环境配置（按需使用）
#
# 用法：把 --mode 传给 uni 命令即可加载本文件
#   npm run build:h5 -- --mode staging
#   npm run build:mp-weixin -- --mode staging
#
# 由于 Vite 只会加载「当前 mode 对应的 .env.<mode>」，
# 想新增环境就复制本文件改名（如 .env.test），无需改代码。
# ============================================================

# 换成你的预发后端地址
VITE_API_BASE_URL=http://192.168.1.100:8000/api
VITE_SSE_BASE_URL=http://192.168.1.100:8000/api

VITE_APP_TITLE=恋爱大师（预发）

# ---------- ICP 备案信息（「我的」页底部展示并链接工信部） ----------
# 境内运营需在显著位置标注备案号并链接 https://beian.miit.gov.cn
# 未配置时界面显示「备案号待配置」占位，不会留空
VITE_BEIAN_ICP=
VITE_BEIAN_OWNER=
# 公安备案号（可选），形如 闽公网安备35010002000000号
VITE_BEIAN_POLICE=
