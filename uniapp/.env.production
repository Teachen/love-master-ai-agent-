# ============================================================
# 生产环境配置（npm run build:h5 / build:mp-weixin / build:app）
#
# ⚠️ 上线前请务必把下面两行改成真实线上地址，否则打包产物仍指向 localhost。
#
# 各端要求：
# - H5：可写同域相对路径 /api（由 nginx 反向代理到后端），
#       也可写完整地址 https://api.your-domain.com/api
# - 微信小程序：必须是 https 完整域名，且要在微信公众平台
#       「开发管理 → 开发设置 → 服务器域名」里配置 request 合法域名
# - App：必须是 https 完整域名（正式包不允许 http 明文请求）
# ============================================================

# 后端地址（微信云托管）
# 部署后在云托管控制台「服务设置 → 基本信息」拿到公网域名，形如
#   https://<服务名>-<环境ID>.<地域>.app.tcloudbase.com
# 把下面两行的 REPLACE-WITH-YOUR-DOMAIN 整体替换成该域名。
#
# ⚠️ 必须是 https：微信小程序和 App 正式包都不允许 http 明文请求。
# ⚠️ 不想为改地址反复打包的话，也可以用 App 首页右上角 ⚙ 在运行时改。
VITE_API_BASE_URL=https://yu-ai-agent-76469-5-1304297249.sh.run.tcloudbase.com/api

# SSE 流式接口地址
# 注意：小程序 / App 端不能写相对路径，必须完整域名
VITE_SSE_BASE_URL=https://yu-ai-agent-76469-5-1304297249.sh.run.tcloudbase.com/api

# 应用标题
VITE_APP_TITLE=恋爱大师
