# ============================================================
# 微信云托管 - 服务环境变量清单
#
# 用法：云托管控制台 → 服务设置 → 基本信息 → 环境变量
#      把下面每一行「键=值」填进去即可（首次新建版本时也会让你填）。
#
# ⚠️ 不要把真实值写进代码或 Dockerfile：
#    .dockerignore 已强制排除 .env / .csv / *.key，镜像里不带任何密钥，
#    云上一律通过环境变量注入。本文件只是清单模板，可安全提交到 Git。
# ============================================================

# ---------- 一、服务基础 ----------
APP_NAME=恋爱大师
APP_ENV=prod
# 云托管默认 80；若「新建版本」时控制台填了别的端口，这里必须改成同一个值
PORT=80
# 线上务必关闭：DEBUG=true 会开启热重载（fork 子进程）并刷 debug 日志
DEBUG=false
# 建议收紧为真实域名，如 ["https://xxx.tcloudbase.com"]；调试期可先用 ["*"]
CORS_ORIGINS=["*"]

# ---------- 二、阿里云百炼 DashScope（必填，否则只能跑通接口、无法对话） ----------
# ⚠️ 本文件是「键名清单」，真实值一律不写在这里。
#    真实值来源：本地 .env（被 .dockerignore 排除，不会进镜像）
#    可用 scripts 生成可粘贴内容：python tmp/gen_cloudrun_env.py
#    生成物：tmp/cloudrun_env.json（对象）/ cloudrun_env_array.json（数组）/ cloudrun_env.txt（行式）
DASHSCOPE_API_KEY=<填你的百炼APIKey，形如 sk-xxxx>
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ---------- 三、RAG 数据源（推荐 bailian，云上零数据库依赖） ----------
# bailian：直接用百炼控制台已配好的知识库，云托管侧不需要任何数据库
# local  ：自建 PGVector 向量库，需要先解决数据库（见第四节）
RAG_BACKEND=bailian
# 百炼控制台 → 业务空间管理，形如 llm-xxxxxxxxxxxx
BAILIAN_WORKSPACE_ID=llm-998qau5yoaiu71l1
# 二选一填一个即可：单库检索填 INDEX_ID，跨库联合检索填 AGENT_ID
BAILIAN_INDEX_ID=Ojwkmwz91w
BAILIAN_AGENT_ID=
BAILIAN_REGION=cn-beijing
BAILIAN_KB_TOP_K=5
BAILIAN_KB_TIMEOUT=30
# 百炼检索失败时是否降级到本地向量库（需要数据库，见下）
BAILIAN_KB_FALLBACK_LOCAL=false

# ---------- 四、向量数据库（仅 RAG_BACKEND=local 时才需要） ----------
# ⚠️ 前提：云托管的 PostgreSQL 必须支持 pgvector 扩展。
#    微信生态的 PostgreSQL 是否开放 pgvector 因版本和地域而异，
#    请在控制台「数据库 → 扩展管理」确认；不支持就改回上面的 bailian 方案。
# PGVECTOR_HOST=
# PGVECTOR_PORT=5432
# PGVECTOR_DATABASE=love_master
# PGVECTOR_USER=
# PGVECTOR_PASSWORD=
# PGVECTOR_TABLE=love_vectors

# ---------- 对话历史存储（MySQL） ----------
# 云托管容器重启后文件系统会清空，历史记录必须落库才能长期保存。
# 不配（MYSQL_ENABLED=false）也能跑：前端自动回退本地存储，只是不跨设备。
MYSQL_ENABLED=true
# 云托管「数据库 → MySQL」开通后控制台给出的**内网**地址（不要填公网地址）
MYSQL_HOST=内网主机地址
MYSQL_PORT=3306
MYSQL_DATABASE=love_master
MYSQL_USER=用户名
MYSQL_PASSWORD=密码
MYSQL_CHARSET=utf8mb4
# 连接池：pool_recycle 要小于数据库的 wait_timeout
MYSQL_POOL_SIZE=5
MYSQL_POOL_RECYCLE=280

# ---------- 账号体系（手机号 / 微信登录） ----------
# 详见 docs/账号体系设计.md
AUTH_ENABLED=true

# ⚠️ 必填：登录态（JWT）签名密钥。留空会退回内置开发密钥，
#    一旦密钥变化，所有已登录用户都会被迫重新登录。
#    生成方式：python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
TOKEN_EXPIRE_DAYS=30

# 短信通道：none=开发模式（验证码直接回显在接口响应里，仅本地联调用）
#           aliyun_pnvs=阿里云号码认证「短信认证」（个人账号可用，用赠送签名/模板）
#           aliyun =阿里云短信服务（仅企业认证，签名需自己申请并报备）
#           tencent=腾讯云短信
# 生产用 none 且未显式放行 → /api/auth/sms/send 直接 503（防止验证码外泄）。
# 配好后用 GET /api/health/config 自检：smsReady=true、smsMissing=[] 即正常。
SMS_PROVIDER=aliyun_pnvs
SMS_CODE_TTL=300
SMS_SEND_INTERVAL=60
SMS_DAILY_LIMIT=10

# ---------- 阿里云短信（SMS_PROVIDER=aliyun / aliyun_pnvs 时必填）----------
# AccessKey 用 RAM 子账号（AliyunDysmsFullAccess 或 AliyunDypnsFullAccess）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 签名与模板：
#   aliyun_pnvs → 号码认证控制台「短信认证参数管理」里的赠送签名 / 赠送模板
#   aliyun      → 自己申请且审核通过的签名 / 模板
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 验证码变量名，必须与模板中 ${xxx} 一致
ALIYUN_SMS_CODE_PARAM=code
ALIYUN_SMS_REGION=cn-hangzhou

# ---------- 腾讯云短信（SMS_PROVIDER=tencent 时必填）----------
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# 微信小程序登录（用于服务端 code2Session 换 openid）
# AppSecret 属敏感信息，只能配在服务端，绝不能下发到前端
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=

# ---------- 五、可选：接口鉴权（公网服务建议开启，避免被白嫖） ----------
# 注意：/api/auth 已在免鉴权白名单内（否则"要先带 Key 才能登录"会形成死锁）
API_KEY_ENABLED=false
API_KEYS=

# ---------- 六、可选：LLM 调用日志 ----------
# 线上建议关闭，避免日志里出现用户输入内容
LLM_LOG_ENABLED=false
LLM_LOG_MAX_CHARS=200
