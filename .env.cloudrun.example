# ============================================================
# 微信云托管 - 服务环境变量清单
#
# 用法：云托管控制台 → 服务设置 → 基本信息 → 环境变量
#      把下面每一行「键=值」填进去即可（首次新建版本时也会让你填）。
#
# ⚠️ 不要把真实值写进代码或 Dockerfile：
#    .dockerignore 已强制排除 .env / .csv / *.key，镜像里不带任何密钥，
#    云上一律通过环境变量注入。本文件只是清单模板，可安全提交到 Git。
# ============================================================

# ---------- 一、服务基础 ----------
APP_NAME=恋爱大师
APP_ENV=prod
# 云托管默认 80；若「新建版本」时控制台填了别的端口，这里必须改成同一个值
PORT=80
# 线上务必关闭：DEBUG=true 会开启热重载（fork 子进程）并刷 debug 日志
DEBUG=false
# 建议收紧为真实域名，如 ["https://xxx.tcloudbase.com"]；调试期可先用 ["*"]
CORS_ORIGINS=["*"]

# ---------- 二、阿里云百炼 DashScope（必填，否则只能跑通接口、无法对话） ----------
DASHSCOPE_API_KEY=sk-ws-H.PHEXLLI.Ifka.MEUCIQD1oC9N1AP3r2eskiGW4XGP2CGyoASqAW_rTALyn2o1ywIgARGUYmdTJASYvDO4E3jRuXaP3t_rixDm2QUH90huY5s
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ---------- 三、RAG 数据源（推荐 bailian，云上零数据库依赖） ----------
# bailian：直接用百炼控制台已配好的知识库，云托管侧不需要任何数据库
# local  ：自建 PGVector 向量库，需要先解决数据库（见第四节）
RAG_BACKEND=bailian
# 百炼控制台 → 业务空间管理，形如 llm-xxxxxxxxxxxx
BAILIAN_WORKSPACE_ID=llm-998qau5yoaiu71l1
# 二选一填一个即可：单库检索填 INDEX_ID，跨库联合检索填 AGENT_ID
BAILIAN_INDEX_ID=Ojwkmwz91w
BAILIAN_AGENT_ID=
BAILIAN_REGION=cn-beijing
BAILIAN_KB_TOP_K=5
BAILIAN_KB_TIMEOUT=30
# 百炼检索失败时是否降级到本地向量库（需要数据库，见下）
BAILIAN_KB_FALLBACK_LOCAL=false

# ---------- 四、向量数据库（仅 RAG_BACKEND=local 时才需要） ----------
# ⚠️ 前提：云托管的 PostgreSQL 必须支持 pgvector 扩展。
#    微信生态的 PostgreSQL 是否开放 pgvector 因版本和地域而异，
#    请在控制台「数据库 → 扩展管理」确认；不支持就改回上面的 bailian 方案。
# PGVECTOR_HOST=
# PGVECTOR_PORT=5432
# PGVECTOR_DATABASE=love_master
# PGVECTOR_USER=
# PGVECTOR_PASSWORD=
# PGVECTOR_TABLE=love_vectors

# ---------- 五、可选：接口鉴权（公网服务建议开启，避免被白嫖） ----------
API_KEY_ENABLED=false
API_KEYS=

# ---------- 六、可选：LLM 调用日志 ----------
# 线上建议关闭，避免日志里出现用户输入内容
LLM_LOG_ENABLED=false
LLM_LOG_MAX_CHARS=200
