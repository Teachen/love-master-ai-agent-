# ============================================================
# 生产环境配置（APP_ENV=prod）
#
# ⚠️ 先说清楚本文件的两个用途，别会错意：
#
#   1) 本地以「生产模式」自测：APP_ENV=prod python main.py
#   2) 作为「生产该配什么」的版本化清单 —— 部署到云托管时照着它去
#      控制台「服务设置 → 环境变量」逐项填，完整清单见 .env.cloudrun.example
#
#   它**不会**被打进 Docker 镜像（.dockerignore 里排除了 .env.*），
#   云上配置一律来自控制台环境变量。这样镜像里永远没有密钥。
#
# ⚠️ 本文件会提交到仓库，**禁止写任何密钥** —— 只放"非密钥的开关与默认值"。
#    密钥（DASHSCOPE_API_KEY / MYSQL_PASSWORD / JWT_SECRET / TENCENT_* /
#    WECHAT_MINIAPP_SECRET）只能写在云托管控制台环境变量里。
# ============================================================

APP_ENV=prod

# ---------- 服务 ----------
# 生产必须关调试：开着会把异常堆栈、内部路径直接返回给调用方
DEBUG=false
HOST=0.0.0.0
# 云托管控制台默认 80，且控制台填的 PORT 会覆盖这里（容器内用 ${PORT} 启动）
PORT=80

# 跨域来源：生产收敛为具体域名，别用 ["*"]。
# 留空表示沿用 .env 的值；部署时在控制台按实际前端域名填写。
# 格式必须是 JSON 数组，例如：["https://your-domain.com"]
# CORS_ORIGINS=["https://your-domain.com"]

# ---------- 对话历史存储 ----------
# 容器文件系统不持久，生产必须落库，否则重启就丢
MYSQL_ENABLED=true

# ---------- RAG 数据源 ----------
# 云上推荐百炼托管知识库：省掉自己维护 PGVector
RAG_BACKEND=bailian

# ---------- 账号体系 ----------
AUTH_ENABLED=true

# 生产必须走真实短信通道。
# 若这里保持 none 又没显式放行，/api/auth/sms/send 会直接返回 503
# —— 这是刻意设计：生产环境回显验证码 = 任何人用任意手机号即可接管账号。
# 想临时演示要开回显，必须显式承担风险地打开这个开关（不推荐）：
# SMS_ALLOW_DEV_CODE_IN_PROD=true
#
# aliyun_pnvs=阿里云号码认证「短信认证」（**个人账号可用**，推荐）
# aliyun=阿里云短信服务（仅企业认证账号可用）
# tencent=腾讯云短信
# 选了哪个就要把对应那组参数配齐，否则「发送验证码」返回 502，
# 提示里会带通道名与原始错误码。缺哪几项用 GET /api/health/config 的 smsMissing 直接看。
# 开通与报备步骤见 docs/短信服务开通指南.md
SMS_PROVIDER=aliyun_pnvs

# ---------- 阿里云（两个通道共用这组变量）----------
# aliyun_pnvs：签名与模板取号码认证控制台「短信认证参数管理」里的**赠送签名/赠送模板**
#              （个人账号不能自定义签名，且赠送签名必须搭配赠送模板使用）
# aliyun     ：签名与模板是自己提交且**审核通过**的，需企业实名认证
# AccessKey 用 RAM 子账号（授予 AliyunDysmsFullAccess / AliyunDypnsFullAccess），
# 不要用主账号密钥；密钥本体只写在控制台环境变量里，不落本文件。
# 变量名必须与模板里 ${xxx} 完全一致，否则接口会因变量个数不匹配而报错。
ALIYUN_SMS_SIGN_NAME=北京恒创联众
ALIYUN_SMS_TEMPLATE_CODE=100001
ALIYUN_SMS_CODE_PARAM=code
ALIYUN_SMS_REGION=cn-hangzhou

# ⚠️ 必填：Token 签名密钥，留空会退回内置开发密钥（源码里可推导）→ 可被伪造登录态。
#    生成：python -c "import secrets;print(secrets.token_hex(32))"
#
# ⚠️⚠️ 值**只能**放云托管控制台的环境变量，绝对不要写在这一行！
#     本文件是被 git 跟踪的（.gitignore 没有忽略 .env.prod），
#     在这里填真值 = 把生产密钥提交进仓库，任何能看仓库的人都能伪造任意用户登录态。
#     这里永远保持空值，只作为「生产需要配这一项」的提示。
JWT_SECRET=

# ---------- 安全与日志 ----------
# 公网服务建议开启，避免接口被白嫖（/api/auth 已在白名单，不影响登录）
API_KEY_ENABLED=false

# 生产关闭 LLM 调用日志：日志里会带用户输入内容，涉及隐私
LLM_LOG_ENABLED=false
LLM_LOG_MAX_CHARS=200
