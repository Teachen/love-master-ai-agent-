# ============================================================
# 恋爱大师 - 环境变量模板
# 使用方式：复制为 .env 后填入真实值
#   copy .env.example .env
# ============================================================

# ---------- 服务基础配置 ----------
APP_NAME=恋爱大师
APP_ENV=dev
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ---------- 阿里云百炼（DashScope）大模型 ----------
# 控制台获取：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选模型：qwen-max / qwen-plus / qwen-turbo
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ---------- RAG 数据源：本地向量库 / 百炼知识库 ----------
# local   = 用 app/rag/documents/*.md 自建向量库（默认，开箱可用）
# bailian = 改用阿里云百炼控制台中已配置好的知识库
RAG_BACKEND=local

# 百炼业务空间 ID，形如 llm-xxxxxxxxxxxx
# 获取位置：百炼控制台 → 业务空间管理
BAILIAN_WORKSPACE_ID=

# 百炼服务地域，默认 cn-beijing
BAILIAN_REGION=cn-beijing

# 【方式一】单知识库底层检索：填知识库 ID 即可
# 获取位置：百炼控制台 → 数据接入 → 知识管理 → 点击知识库复制 index_id
# 特点：直接返回向量+关键词召回结果，不做 Rerank
BAILIAN_INDEX_ID=

# 【方式二】跨知识库联合检索（二选一，优先级更高）
# 检索服务 ID，形如 aid-xxxxxxxxxxxxxxxx
# 获取位置：百炼控制台 → 知识服务 → 知识检索 → 创建并【发布】后获取
# 特点：多库权重、知识路由、混排模型等策略在控制台配好，调用方只传 query
BAILIAN_AGENT_ID=

# 检索默认召回条数
BAILIAN_KB_TOP_K=5
# 单次检索超时（秒）
BAILIAN_KB_TIMEOUT=30
# 百炼检索失败时是否降级到本地向量库（false 则直接报错，便于暴露配置问题）
BAILIAN_KB_FALLBACK_LOCAL=false

# ---------- 向量数据库（PGVector） ----------
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=love_master
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=postgres
PGVECTOR_TABLE=love_vectors

# ---------- Ollama 本地模型（可选） ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b

# ---------- 第三方接口（可选） ----------
# SearchAPI 联网搜索
SEARCH_API_KEY=
# Pexels 图库
PEXELS_API_KEY=

# ---------- 文件存储 ----------
FILE_SAVE_DIR=./tmp/files
PDF_SAVE_DIR=./tmp/pdf

# ---------- 前置鉴权（HTTP 拦截器） ----------
# 开启后，除健康检查/文档外，所有 /api/* 接口需在请求头携带 X-API-Key
API_KEY_ENABLED=false
# 有效 Key 列表，英文逗号分隔；开启鉴权后必须至少配置一个，否则全部拒绝
API_KEYS=

# ---------- LLM 调用日志（对应 Java MyLoggerAdvisor） ----------
# 成对打印每次大模型调用的请求消息与响应文本，排查 Prompt 与多轮记忆时打开
LLM_LOG_ENABLED=true
# 日志中每条消息的最大截断长度
LLM_LOG_MAX_CHARS=200

# ============================================================
# 账号体系（手机号 / 微信登录）
#
# ⚠️ 这套东西有两道「开关」，缺任何一个都会表现为「发送验证码不可用」：
#
#   ① 数据库：验证码和账号都要落库。MYSQL_ENABLED=false 时账号接口一律 503。
#      本地零依赖自测可直接用 sqlite（不需要装 MySQL）：
#        MYSQL_ENABLED=true
#        MYSQL_HOST=sqlite:///./tmp/dev.db
#
#   ② 短信通道：SMS_PROVIDER=none 是开发模式（发不出真短信，验证码回显）；
#      生产必须配 aliyun 或 tencent 并补齐参数，否则 503/502。
#
# 配好后访问 GET /api/health/config 自检：smsReady=true 且 smsMissing=[] 即为正常。
# 开通阿里云短信的完整步骤见 docs/短信服务开通指南.md
# ============================================================
AUTH_ENABLED=true
# 本地开发一般没有 MySQL，按需打开（打开后账号功能才可用）
MYSQL_ENABLED=false
# 想本地验证账号链路又不想装 MySQL：MYSQL_HOST=sqlite:///./tmp/dev.db
MYSQL_HOST=localhost

# ---------- 短信通道 ----------
# none=开发模式（验证码回显，不发真短信）
# aliyun_pnvs=阿里云号码认证「短信认证」—— **个人实名账号可用**，用平台赠送签名/模板
# aliyun=阿里云短信服务（仅企业实名认证账号可用，签名需自己申请并报备）
# tencent=腾讯云短信
SMS_PROVIDER=none
SMS_CODE_TTL=300
SMS_SEND_INTERVAL=60
SMS_DAILY_LIMIT=10
# 生产环境禁止回显验证码（改了等于把任意账号的登录码公开给任何人）
SMS_ALLOW_DEV_CODE_IN_PROD=false

# ---------- 阿里云短信（SMS_PROVIDER=aliyun 或 aliyun_pnvs）----------
# 短信服务控制台：https://dysms.console.aliyun.com/
# 号码认证控制台：https://dypns.console.aliyun.com/
# AccessKey 建议用 RAM 子账号 + 只授对应权限，不要用主账号密钥
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 签名名称：短信里【】内的内容。
#   aliyun_pnvs → 取控制台「短信认证参数管理 → 赠送签名配置」
#   aliyun      → 自己申请且**审核通过**的签名（需企业资质）
ALIYUN_SMS_SIGN_NAME=
# 模板 Code，形如 SMS_154950909 / 100001，必须是**审核通过**（或赠送）的模板
ALIYUN_SMS_TEMPLATE_CODE=
# 验证码在模板里的变量名，要与模板中 ${xxx} 里的名字完全一致
ALIYUN_SMS_CODE_PARAM=code
ALIYUN_SMS_REGION=cn-hangzhou
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# ---------- 腾讯云短信（SMS_PROVIDER=tencent）----------
# 控制台：https://console.cloud.tencent.com/smsv2
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# ---------- 微信小程序登录 ----------
# 后端用 code2Session 换 openid；AppSecret 绝不能下发到前端
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=

# ---------- Token 签名密钥 ----------
# 留空会用内置开发密钥（源码可推导 → 可伪造登录态）。生产必须显式配置：
#   python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
TOKEN_EXPIRE_DAYS=30
