# ============================================================
# Docker 构建上下文排除清单（微信云托管部署）
#
# 两个目的：
#   1. 微信云托管「手动上传代码包」整包限制 ≤ 2 MiB
#   2. 绝不把 .env / 密钥文件打进镜像 —— 云上配置一律走
#      「服务设置 → 环境变量」，镜像里不留任何密钥
# ============================================================

# ---------- 敏感信息（最高优先级） ----------
.env
.env.*
*.key
*.pem
*.csv
Ai恋爱大师-apiKey-*.csv

# ---------- Python ----------
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---------- 前端（后端镜像不需要，体积很大） ----------
uniapp/

# ---------- 本地数据与临时产物 ----------
data/postgres/
tmp/
*.log
*.sqlite3

# ---------- 文档与素材 ----------
docs/
*.png
*.jpg
*.jpeg
*.gif

# ---------- IDE / 版本控制 / 工具 ----------
.idea/
.vscode/
.git/
.github/
.workbuddy/
.DS_Store

# ---------- 测试与本地调试脚本 ----------
tests/
.pytest_cache/
