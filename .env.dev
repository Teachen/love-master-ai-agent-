# ============================================================
# 开发环境配置（APP_ENV=dev）
#
# 加载顺序：.env → .env.dev → 系统环境变量
# 启动方式：直接 python main.py（APP_ENV 默认就是 dev）
#
# ⚠️ 本文件会提交到仓库，**禁止写任何密钥**。
#    密钥统一放 .env（已被 .gitignore 排除）或系统环境变量。
#
# 这里只写「开发环境区别于生产环境」的项，其余走 .env 与代码默认值。
# ============================================================

APP_ENV=dev

# ---------- 服务 ----------
# 本地开发开调试：改代码自动重载、异常返回堆栈
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]

# ---------- 对话历史存储 ----------
# 本机一般没装 MySQL，关掉即可：前端自动回退本地存储，对话功能不受影响。
# ⚠️ 但账号体系（手机号登录 / 验证码 / 微信登录）**依赖数据库**：
#    只管着对话历史的话，进登录页点「发送验证码」会直接拿到 503
#    「账号服务未就绪」—— 这不是短信通道的问题。
#
# 想本地把登录链路跑通，两种方式（推荐第一种，零依赖）：
#   MYSQL_ENABLED=true
#   MYSQL_HOST=sqlite:///./tmp/dev.db      # 用 sqlite 自测，无需安装 MySQL
# 或者指向本机真实 MySQL：MYSQL_HOST=localhost + MYSQL_USER/PASSWORD/DATABASE
#
# 已按 sqlite 打开：本机没装 MySQL，而账号体系必须有库才能用。
# 关掉的话，登录页点「发送验证码」一定是 503（与短信通道无关）。
MYSQL_ENABLED=true
MYSQL_HOST=sqlite:///./tmp/dev.db

# ---------- RAG 数据源 ----------
# 本地用向量库，需要本机跑 PGVector；云上推荐 bailian（零数据库依赖）
RAG_BACKEND=local

# ---------- 账号体系 ----------
AUTH_ENABLED=true
# 短信通道：aliyun_pnvs = 号码认证「短信认证」，**真实发送短信**（个人实名账号可用）
#
# ⚠️ 测试与生产都真发短信，因此：
#   1. 会产生费用（有赠送额度，按条计费）。
#   2. 本地与线上共用同一个阿里云账号/签名/号码的频控额度
#      （1 条/分钟、5 条/小时、10 条/天），本地连点会挤掉线上的额度，
#      表现为 App 报 biz.FREQUENCY。
#      → 强烈建议把常用测试号加进号码认证控制台「通用设置」的白名单
#        （最多 300 个，白名单号码不受流控）。
#   3. 真发模式下**不回显验证码**（settings.sms_dev_code_exposed 对真实通道恒为 false）。
#      这是刻意的安全设计：真发了还回显，等于任何人拿任意手机号请求就能取到别人的验证码。
#      联调时请直接看手机短信。
#
# 想临时改回「不发真短信、验证码回显」：把 SMS_PROVIDER 改成 none 并**重启后端**
# （uvicorn 热重载不监听 .env 文件）。改回来只需再改回 aliyun_pnvs。
#
# 密钥写在本机 .env（已被 .gitignore 忽略）。本文件被 git 跟踪，禁止写密钥。
SMS_PROVIDER=aliyun_pnvs
ALIYUN_SMS_SIGN_NAME=北京恒创联众
ALIYUN_SMS_TEMPLATE_CODE=100001
ALIYUN_SMS_CODE_PARAM=code
# 开发用内置签名密钥，重启不会掉登录态（.env.prod 里必须显式配置）
# ⚠️ 本文件被 git 跟踪，**不要在这里填真实密钥**。
#    真要显式指定，请放本地 .env（已被 .gitignore 忽略）或直接设环境变量。
JWT_SECRET=

# ---------- 日志 ----------
# 开发期打印每次 LLM 调用的请求/响应，方便对比 Java 版行为
LLM_LOG_ENABLED=true
LLM_LOG_MAX_CHARS=200
